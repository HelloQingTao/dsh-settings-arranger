{
  "name": "dsh-settings-arranger",
  "version": "0.2.0",
  "description": "设置页导航整理器：给 dsh 设置对话框左侧分区导航加拖拽排序、自定义分组与折叠 | Settings nav arranger for DeepSeek Harness: drag-to-reorder and group your settings sections",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "docs/design-plan.md"
  ],
  "license": "MIT",
  "author": "HelloQingTao",
  "homepage": "https://github.com/HelloQingTao/dsh-settings-arranger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloQingTao/dsh-settings-arranger.git"
  },
  "bugs": {
    "url": "https://github.com/HelloQingTao/dsh-settings-arranger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "navigation",
    "reorder",
    "drag-and-drop",
    "group",
    "customize"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/host.test.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.2"
      ]
    }
  }
}
